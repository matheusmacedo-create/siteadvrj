# Hostinger / Apache / LiteSpeed — compressão, cache e redirecionamentos
# Não envie README.md nem a pasta .git para a hospedagem.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /index.html -> / (evita página duplicada)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
  # Ative SOMENTE depois que o domínio apontar para a hospedagem
  # (ou use "Forçar HTTPS" no hPanel):
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} !^www\.mbladvocacia\.com\.br$ [NC]
  # RewriteRule ^ https://www.mbladvocacia.com.br%{REQUEST_URI} [L,R=301,NE]
</IfModule>
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(js|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.html
